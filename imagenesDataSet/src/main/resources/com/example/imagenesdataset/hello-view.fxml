<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.control.ScrollPane?>
<VBox alignment="CENTER" prefHeight="441.0" prefWidth="665.0" spacing="20.0" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.example.imagenesdataset.Controllers.MainController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>
    <!-- ScrollPane envuelve el FlowPane -->
    <ScrollPane fitToWidth="true" vbarPolicy="AS_NEEDED" hbarPolicy="NEVER" prefHeight="406.0" prefWidth="625.0">
        <content>
            <FlowPane fx:id="contenedorImagenes" hgap="10.0" vgap="10.0" prefWrapLength="600.0" />
        </content>
    </ScrollPane>


    <Label fx:id="welcomeText" />
</VBox>
