<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ejemplo.listadetareas.ListaDeTareasController"
            prefWidth="500" prefHeight="420"
            style="-fx-background-color: #f0f4f8; -fx-padding: 20;">

    <top>
        <VBox spacing="10" BorderPane.alignment="CENTER">
            <Label text="Lista de Tareas" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>
            <HBox spacing="10">
                <TextField fx:id="txtTarea" promptText="Escriba una nueva tarea..." maxWidth="Infinity"
                           style="-fx-font-size: 14px; -fx-padding: 8; -fx-background-radius: 6; -fx-border-radius: 6;"
                           HBox.hgrow="ALWAYS"/>
                <Button text="Agregar" onAction="#handleAgregar" prefWidth="90"
                        style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 14px;
                               -fx-padding: 8 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="5" style="-fx-padding: 10 0 0 0;">
            <ListView fx:id="listaTareas" prefHeight="220"
                      style="-fx-background-radius: 8; -fx-border-radius: 8;"/>
        </VBox>
    </center>

    <bottom>
        <VBox spacing="10" style="-fx-padding: 10 0 0 0;" BorderPane.alignment="CENTER">
            <HBox spacing="10" alignment="CENTER">
                <Button text="✔ Completar" onAction="#handleMarcarCompletada" prefWidth="130"
                        style="-fx-background-color: #48bb78; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-padding: 8 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
                <Button text="✖ Eliminar" onAction="#handleEliminar" prefWidth="130"
                        style="-fx-background-color: #fc8181; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-padding: 8 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
                <Button text="🗑 Limpiar todo" onAction="#handleLimpiarTodo" prefWidth="130"
                        style="-fx-background-color: #a0aec0; -fx-text-fill: white; -fx-font-size: 13px;
                               -fx-padding: 8 12; -fx-background-radius: 6; -fx-cursor: hand;"/>
            </HBox>
            <Label fx:id="lblContador" text="Total de tareas: 0"
                   style="-fx-font-size: 13px; -fx-text-fill: #718096;"/>
        </VBox>
    </bottom>

</BorderPane>
