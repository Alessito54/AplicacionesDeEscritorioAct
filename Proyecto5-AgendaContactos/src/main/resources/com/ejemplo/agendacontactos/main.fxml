<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.ejemplo.agendacontactos.AgendaContactosController"
            prefWidth="700" prefHeight="520"
            style="-fx-background-color: #f0f4f8; -fx-padding: 20;">

    <top>
        <VBox spacing="10" BorderPane.alignment="CENTER">
            <Label text="Agenda de Contactos" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2d3748;"/>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="🔍 Buscar:" style="-fx-font-size: 13px;"/>
                <TextField fx:id="txtBuscar" promptText="Buscar contacto..." prefWidth="250"
                           style="-fx-font-size: 13px; -fx-padding: 6; -fx-background-radius: 5;"/>
            </HBox>

            <GridPane hgap="10" vgap="8">
                <Label text="Nombre:" GridPane.rowIndex="0" GridPane.columnIndex="0"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtNombre" promptText="Nombre completo"
                           GridPane.rowIndex="0" GridPane.columnIndex="1" prefWidth="180"
                           style="-fx-font-size: 13px; -fx-padding: 6; -fx-background-radius: 5;"/>

                <Label text="Teléfono:" GridPane.rowIndex="0" GridPane.columnIndex="2"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtTelefono" promptText="Número de teléfono"
                           GridPane.rowIndex="0" GridPane.columnIndex="3" prefWidth="180"
                           style="-fx-font-size: 13px; -fx-padding: 6; -fx-background-radius: 5;"/>

                <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-font-size: 13px; -fx-font-weight: bold;"/>
                <TextField fx:id="txtEmail" promptText="Correo electrónico"
                           GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3" maxWidth="Infinity"
                           style="-fx-font-size: 13px; -fx-padding: 6; -fx-background-radius: 5;"/>

                <HBox spacing="10" GridPane.rowIndex="2" GridPane.columnIndex="0" GridPane.columnSpan="4">
                    <Button text="➕ Agregar" onAction="#handleAgregar" prefWidth="120"
                            style="-fx-background-color: #4299e1; -fx-text-fill: white; -fx-font-size: 13px;
                                   -fx-padding: 7 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Button text="✏ Actualizar" onAction="#handleActualizar" prefWidth="120"
                            style="-fx-background-color: #f6ad55; -fx-text-fill: white; -fx-font-size: 13px;
                                   -fx-padding: 7 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Button text="✖ Eliminar" onAction="#handleEliminar" prefWidth="120"
                            style="-fx-background-color: #fc8181; -fx-text-fill: white; -fx-font-size: 13px;
                                   -fx-padding: 7 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
                    <Button text="Limpiar" onAction="#handleLimpiar" prefWidth="100"
                            style="-fx-background-color: #a0aec0; -fx-text-fill: white; -fx-font-size: 13px;
                                   -fx-padding: 7 14; -fx-background-radius: 6; -fx-cursor: hand;"/>
                </HBox>
            </GridPane>
        </VBox>
    </top>

    <center>
        <TableView fx:id="tablaContactos" style="-fx-border-radius: 8; -fx-background-radius: 8;"
                   BorderPane.alignment="CENTER">
            <columns>
                <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
                <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="160"/>
                <TableColumn fx:id="colEmail" text="Email" prefWidth="270"/>
            </columns>
        </TableView>
    </center>

    <bottom>
        <Label fx:id="lblTotal" text="Total de contactos: 0"
               style="-fx-font-size: 13px; -fx-text-fill: #718096; -fx-padding: 8 0 0 0;"
               BorderPane.alignment="CENTER_LEFT"/>
    </bottom>

</BorderPane>
