<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="450.0" prefWidth="550.0" spacing="20.0" styleClass="root" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.paisesdataset.HelloController">
    <stylesheets>
        <URL value="@style.css"/>
    </stylesheets>
    <padding>
        <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
    </padding>

    <VBox alignment="CENTER" spacing="30.0" styleClass="card" maxWidth="400.0" prefHeight="300.0">
        <padding>
            <Insets bottom="40.0" left="40.0" right="40.0" top="40.0" />
        </padding>
        
        <Label text="Seleccione un país" styleClass="title-label" />
        
        <ComboBox fx:id="boxPaises" prefWidth="250.0" styleClass="combo-box" />
        
        <Button fx:id="buttonBuscar" mnemonicParsing="false" onAction="#buscar" text="Buscar" styleClass="button-primary" prefWidth="180.0" />
    </VBox>

    <Label fx:id="welcomeText" styleClass="info-text" />
</VBox>
